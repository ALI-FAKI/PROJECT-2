        "import jax.numpy as jnp\n",
        "from jax import jit, grad\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# --- Model parameters ---\n",
        "L = 1000.0          # length of the channel (m)\n",
        "N = 100             # number of grid cells\n",
        "dx = L / N\n",
        "g = 9.81            # gravity (m/s^2)\n",
        "H = 10.0            # mean water depth (m)\n",
        "rho = 1025.0        # water density (kg/m^3)\n",
        "r = 0.001           # linear bottom friction (1/s)\n",
        "dt = 0.05           # time step (s)\n",
        "nt = 500            # number of time steps\n",
        "\n",
        "# --- Grid ---\n",
        "x_h = (jnp.arange(N) + 0.5) * dx   # cell centers (water level)\n",
        "x_u = jnp.arange(N + 1) * dx       # cell faces (velocity)\n",
        "\n",
        "# --- Initial conditions ---\n",
        "h = jnp.zeros(N)       # water surface elevation\n",
        "u = jnp.zeros(N + 1)   # current velocity\n",
        "\n",
        "# --- Wind stress (N/m^2) ---\n",
        "tau_w = 0.1\n",
        "\n",
        "# --- One time step ---\n",
        "def step(h, u, tau_w):\n",
        "    # Update water height: dh/dt = -H * du/dx\n",
        "    du_dx = (u[1:] - u[:-1]) / dx\n",
        "    h_new = h - dt * H * du_dx\n",
        "\n",
        "    # Update velocity: du/dt = -g * dh/dx + tau_w/(rho*H) - r*u\n",
        "    dh_dx = (h[1:] - h[:-1]) / dx\n",
        "    u_new = u.at[1:-1].set(\n",
        "        u[1:-1] + dt * (-g * dh_dx + tau_w / (rho * H) - r * u[1:-1])\n",
        "    )\n",
        "    # Closed walls at both ends\n",
        "    u_new = u_new.at[0].set(0.0)\n",
        "    u_new = u_new.at[-1].set(0.0)\n",
        "    return h_new, u_new\n",
        "\n",
        "step_jit = jit(step)  # compile for speed\n",
        "\n",
        "# --- Run model ---\n",
        "h_store = []\n",
        "for n in range(nt):\n",
