      "source": [
        "import jax.numpy as jnp\n",
        "from jax import jit, grad\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# --- Model parameters ---\n",
        "Lx = 1000.0         # length in x (m)\n",
        "Ly = 1000.0         # length in y (m)\n",
        "Nx = 50             # number of grid cells in x\n",
        "Ny = 50             # number of grid cells in y\n",
        "dx = Lx / Nx\n",
        "dy = Ly / Ny\n",
        "\n",
        "g = 9.81            # gravity (m/s^2)\n",
        "H = 10.0            # mean water depth (m)\n",
        "rho = 1025.0        # water density (kg/m^3)\n",
        "r = 0.001           # linear bottom friction (1/s)\n",
        "dt = 0.05           # time step (s)\n",
        "nt = 1000           # number of time steps\n",
        "\n",
        "# --- Arakawa C-grid: h at cell centers, u at east-west faces, v at north-south faces ---\n",
        "# h: shape (Ny, Nx)          (center of cell)\n",
        "# u: shape (Ny, Nx+1)        (west/east faces)\n",
        "# v: shape (Ny+1, Nx)        (south/north faces)\n",
        "\n",
        "x_h = (jnp.arange(Nx) + 0.5) * dx   # cell center x coordinates\n",
        "y_h = (jnp.arange(Ny) + 0.5) * dy   # cell center y coordinates\n",
        "\n",
        "# --- Initial conditions ---\n",
        "h = jnp.zeros((Ny, Nx))               # flat water surface\n",
        "u = jnp.zeros((Ny, Nx + 1))           # no current\n",
        "v = jnp.zeros((Ny + 1, Nx))           # no current\n",
        "\n",
        "# --- Wind stress (N/m^2) ---\n",
        "tau_x = 0.1    # wind in x direction (eastward)\n",
        "tau_y = 0.0    # no wind in y\n",
        "\n",
        "# --- One time step (explicit finite volume) ---\n",
        "def step(h, u, v, tau_x, tau_y):\n",
        "    # Update water height: dh/dt = -H * (du/dx + dv/dy)\n",
        "    du_dx = (u[:, 1:] - u[:, :-1]) / dx\n",
        "    dv_dy = (v[1:, :] - v[:-1, :]) / dy\n",
        "    h_new = h - dt * H * (du_dx + dv_dy)\n",
        "\n",
        "    # Update u velocity: du/dt = -g * dh/dx + tau_x/(rho*H) - r*u\n",
        "    # At interior u points (exclude left and right boundaries)\n",
        "    dh_dx = (h[:, 1:] - h[:, :-1]) / dx   # h at cell centers, u points are between them\n",
        "    u_int = u[:, 1:-1]  # interior u points, shape (Ny, Nx-1)\n",
        "    u_new = u.at[:, 1:-1].set(\n",
        "        u_int + dt * (-g * dh_dx + tau_x / (rho * H) - r * u_int)\n",
        "    )\n",
        "    # Closed boundary: u = 0 at western and eastern walls\n",
        "    u_new = u_new.at[:, 0].set(0.0)\n",
        "    u_new = u_new.at[:, -1].set(0.0)\n",
        "\n",
        "    # Update v velocity: dv/dt = -g * dh/dy + tau_y/(rho*H) - r*v\n",
        "    # At interior v points (exclude top and bottom boundaries)\n",
        "    dh_dy = (h[1:, :] - h[:-1, :]) / dy   # h at cell centers, v points are between them\n",
        "    v_int = v[1:-1, :]  # interior v points, shape (Ny-1, Nx)\n",
        "    v_new = v.at[1:-1, :].set(\n",
        "        v_int + dt * (-g * dh_dy + tau_y / (rho * H) - r * v_int)\n",
        "    )\n",
        "    # Closed boundary: v = 0 at southern and northern walls\n",
        "    v_new = v_new.at[0, :].set(0.0)\n",
        "    v_new = v_new.at[-1, :].set(0.0)\n",
        "\n",
        "    return h_new, u_new, v_new\n",
        "\n",
        "step_jit = jit(step)   # compile for speed (runs on GPU if available)\n",
        "\n",
        "# --- Run the model ---\n",
        "for n in range(nt):\n",
        "    h, u, v = step_jit(h, u, v, tau_x, tau_y)\n",
        "\n",
        "# --- Plot results ---\n",
        "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5))\n",
        "\n",
        "# Water surface elevation\n",
        "c1 = ax1.contourf(x_h, y_h, h, levels=20, cmap='RdBu_r')\n",
        "ax1.set_title('Water surface elevation (m)')\n",
        "ax1.set_xlabel('x (m)')\n",
        "ax1.set_ylabel('y (m)')\n",
        "fig.colorbar(c1, ax=ax1)\n",
        "\n",
        "# Velocity field (average u,v to cell centers for plotting)\n",
        "u_center = 0.5 * (u[:, :-1] + u[:, 1:])   # shape (Ny, Nx)\n",
        "v_center = 0.5 * (v[:-1, :] + v[1:, :])   # shape (Ny, Nx)\n",
        "\n",
        "# Use quiver for velocity vectors (skip every few points for clarity)\n",
        "skip = 3\n",
        "ax2.quiver(x_h[::skip], y_h[::skip], u_center[::skip, ::skip], v_center[::skip, ::skip], scale=2)\n",
        "ax2.set_title('Current velocity vectors')\n",
        "ax2.set_xlabel('x (m)')\n",
        "ax2.set_ylabel('y (m)')\n",
        "ax2.set_aspect('equal')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
